# FloodSense API Configuration
# Configurable for Vite, Next.js, and standalone frontends

# Next.js Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api
NEXT_PUBLIC_MODEL_NAME=segformer-b2-floodnet
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Vite Alternative (if using Vite runner)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_OFFLINE_DEMO=true
